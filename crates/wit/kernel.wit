package trovato:kernel;

/// Item API — full-serialization access to items.
/// Plugins receive and return complete item JSON, avoiding multiple
/// boundary crossings. Phase 0 benchmarks proved this is 1.2-1.6x faster
/// than handle-based field access.
///
/// Every call is decided as the user the plugin is acting for. A request-scoped
/// call — any user that is not the background principal, anonymous included —
/// gets that user's own answer: get-item requires `view` and drops the fields
/// the user may not see, query-items returns what the user may view, save-item
/// requires `edit` on an update and `create {type} content` on a create, and
/// delete-item requires `delete`. A denied read is indistinguishable from a
/// missing item and returns null; a denied write returns host error code -60
/// (ERR_ITEM_ACCESS_DENIED).
///
/// A background call — cron or the queue worker, under the kernel-internal
/// background principal — has no user whose authority it could act with, so it
/// needs the `item_background = true` manifest capability. With it the call
/// acts with kernel authority; without it, host error code -61
/// (ERR_ITEM_BACKGROUND_DENIED).
///
/// Writes go through the kernel's item service, exactly as a person's edit does:
/// save-item and delete-item fire tap-item-presave, tap-item-insert or
/// tap-item-update, tap-item-update-index and tap-item-delete on the other
/// plugins, run the field and publish write gates (a refusal is -60) and the
/// field value check (too many values for a field's cardinality, or a value
/// that is not a tag of a category reference field's category: -65,
/// ERR_ITEM_INVALID_FIELDS), record a revision and refresh the item cache. A tap handling a write may write again:
/// the nested write fires its taps to every plugin except those whose write tap
/// is already running around it, and a write nested 4 write taps deep is
/// refused with -63 (ERR_ITEM_WRITE_DEPTH). A call made while an access
/// decision is in progress fails closed with -60.
interface item-api {
    /// Get an item by ID, returns full item JSON.
    get-item: func(id: string) -> result<string, string>;

    /// Save an item from JSON: an update when it carries a non-nil `id`
    /// (`title`, `status`, `fields`, `log`; null if no item has that id), a
    /// create otherwise (`type` required; `title`, `status`, `fields`, `log`,
    /// and `language`, which must be one of the site's languages, else -14).
    save-item: func(item-json: string) -> result<string, string>;

    /// Delete an item by ID. An id that names no item is -62
    /// (ERR_ITEM_NOT_FOUND).
    delete-item: func(id: string) -> result<_, string>;

    /// Query items with structured query, returns JSON array: {type, status,
    /// limit (at most 100, default 50), offset}, the items the user may view on
    /// the request's read stages (Live outside a plugin route), newest change
    /// first, ties broken by id. Until B80 it listed every stage. Deprecated for
    /// listings in favour of `query.run`, which sorts, joins, pages and returns
    /// each row's URL; this stays for loading full items.
    query-items: func(query-json: string) -> result<string, string>;

    /// The translations of up to 100 items (`item-ids-json`, a JSON array of
    /// ids) the user may view, as a JSON array of `{item_id, language, title,
    /// fields, created, changed}`, by item in the order asked and then by
    /// language, with the field tier applied to `fields`. Added by B80.
    list-translations: func(item-ids-json: string) -> result<string, string>;

    /// Create or replace one language's translation of an item from
    /// `{item_id, language, title, fields}`, through the kernel's item
    /// service: it needs `edit` access, or `translate content` and `view`;
    /// the field write gate applies; tap-item-update fires on the other
    /// plugins and the item cache drops the item. A language that is not the
    /// site's, or is the item's own, is -14; no such item is -62. Returns the
    /// saved translation. Added by B80.
    save-translation: func(translation-json: string) -> result<string, string>;

    /// Remove one language's translation of an item, decided as
    /// save-translation is; tap-item-update fires when one was removed.
    /// Returns whether there was one. Added by B80.
    delete-translation: func(item-id: string, language: string) -> result<bool, string>;
}

/// Structured database API — prevents SQL injection from plugins.
///
/// WASM-2 / D-19 table scoping (enforced since the WASM-2 build): the structured
/// calls (select/insert/update/delete) are confined to the plugin's *effective
/// allowlist* — the tables its own migrations CREATE, unioned with the explicit
/// `db_tables` in its `[capabilities]` manifest. A structured call targeting a
/// table outside that set is rejected (host error code -16, `table-not-declared`)
/// before any query runs.
///
/// Underneath that allowlist is a protected floor, checked first and applying
/// whatever the manifest or the migrations say: the credential, authorization
/// and plugin-control tables (users, roles, permission grants, tokens of every
/// kind, passkeys, the security audit log, plugin status and migrations, the
/// form-state cache, site_config, oauth_client, webhook). A call to one of
/// those is rejected with the same -16 code; the host log distinguishes it as
/// `table-protected`.
///
/// The raw calls (query-raw/execute-raw) are gated on the declared
/// `raw_sql = true` capability (host error code -17, `raw-sql-not-declared`),
/// and they ARE parsed. Each statement is parsed with the PostgreSQL dialect
/// and judged as a tree: query-raw takes a read and nothing else and runs in a
/// transaction the server opens READ ONLY, execute-raw takes exactly one
/// INSERT, UPDATE or DELETE, neither may name a protected table or call a
/// function that changes session state, reaches the server's files or takes a
/// table by name, and a statement that does not parse is refused.
///
/// Raw SQL is still a declared trust grant rather than a closed door: a plugin
/// holding `raw_sql` can read any table the protected floor does not cover. The
/// parser and the read-only transaction close the paths that ran past that
/// grant. A per-plugin database role remains the stronger post-1.0 option.
interface db {
    select: func(query-json: string) -> result<string, string>;
    insert: func(table: string, data-json: string) -> result<string, string>;
    /// `where-json` on update and delete is a map (each key equal to its value)
    /// or, since B80, an array of `{"field", "op", "value"}` conditions, ANDed,
    /// with `op` one of `=`, `!=`, `<`, `<=`, `>`, `>=`, `in`, `not_in`,
    /// `is_null`, `is_not_null`. An empty where, an unknown op or an empty `in`
    /// list is -14: none of them may mean every row.
    update: func(table: string, data-json: string, where-json: string) -> result<u64, string>;
    delete: func(table: string, where-json: string) -> result<u64, string>;

    /// Insert a row, or on a conflict update it. `conflict-json` is
    /// `{"target": [cols], "update": [cols]}`; the update set defaults to
    /// every column of the row not in the target. Returns the row, as insert
    /// does. Added by B80: a new function, no signature changed.
    upsert: func(table: string, data-json: string, conflict-json: string) -> result<string, string>;

    /// Insert up to 500 rows (`rows-json`, a JSON array of objects that name
    /// the same columns) in one statement, so all or none are written. More
    /// than 500 is refused whole with -82 (ERR_DB_BATCH_TOO_LARGE). Returns
    /// the rows written. Added by B80: a new function, no signature changed.
    insert-many: func(table: string, rows-json: string) -> result<u64, string>;
    query-raw: func(sql: string, params-json: string) -> result<string, string>;
    execute-raw: func(sql: string, params-json: string) -> result<u64, string>;

    /// Queue items for the static search index after changing something that
    /// decides what their search page holds and that no table trigger sees,
    /// such as data a plugin's `tap-field-access` reads. Writes to the
    /// `item`, `comment` and `url_alias` tables are queued by the database.
    /// `item-ids-json` is a JSON array of item UUIDs, at most 10,000 (-82 past
    /// that, -14 when it is not such an array); returns how many were queued.
    /// Cron rewrites only those items' part of the index. Added by B218: a new
    /// function, no signature changed.
    search-index-enqueue: func(item-ids-json: string) -> result<u64, string>;
}

/// Persistent key-value configuration.
interface variables {
    get: func(name: string, default-value: string) -> string;
    set: func(name: string, value: string) -> result<_, string>;
}

/// Per-request shared state (key-value).
interface request-context {
    get: func(key: string) -> option<string>;
    set: func(key: string, value: string);
}

/// User and permission checks.
interface user-api {
    /// Whether the current user may do the named thing.
    ///
    /// This is the *effective* permission, the same question the kernel's own
    /// route guards ask: a site administrator holds every permission, and
    /// everyone else holds what their roles grant. A plugin does not need to,
    /// and should not, add an administrator case of its own.
    ///
    /// `administer site` is an ordinary permission with no special meaning
    /// here: it is held by the roles granted it, and it does not make its
    /// holder an administrator.
    current-user-has-permission: func(permission: string) -> bool;
    current-user-id: func() -> string;

    /// Public facts about the site's users, by id, for a plugin that declares
    /// `user_directory = true` under `[capabilities]`. Declaring `user-api`
    /// alone does not grant it.
    ///
    /// Answers a JSON array of `{id, name, status, timezone, language,
    /// created}` for the ids that name a user, in one query, where `status`
    /// is `"active"` or `"blocked"` and `created` is unix seconds. An id that
    /// names nobody is left out. Never an address, a password hash or the
    /// user's `data`. At most 100 ids a call, so a digest over many members
    /// costs one query per hundred, not one per member; a malformed id or
    /// more than 100 is refused.
    ///
    /// Added by B73, after 0.104.0: a new function in an existing interface
    /// and a new manifest capability; no existing signature changed.
    load-users: func(user-ids: list<string>) -> result<string, string>;

    /// The one account named `name`, for a plugin that declares
    /// `user_directory = true` under `[capabilities]` (the same grant
    /// `load-users` needs; declaring `user-api` alone does not grant it).
    ///
    /// Answers the same `{id, name, status, timezone, language, created}`
    /// shape as `load-users`, for the account whose name matches `name`
    /// case-insensitively — the same match the kernel's own login makes — or
    /// JSON `null` when no account has that name. `name` must be 1 to 255
    /// characters.
    ///
    /// No status or identity filter beyond the capability gate: a blocked
    /// account or the anonymous account answers like any other.
    ///
    /// Added by B179, after 0.104.0: a new function in an existing interface
    /// and no new manifest capability; no existing signature changed.
    find-user-by-name: func(name: string) -> result<string, string>;

    /// Up to 10 accounts whose name starts with `prefix`, for a plugin that
    /// declares `user_directory = true` under `[capabilities]`: a short list
    /// an autocomplete widget can offer as a person types, not a directory
    /// dump.
    ///
    /// Answers a JSON array in the same shape as `load-users`, sorted by
    /// name, matching case-insensitively. `prefix` must be 1 to 255
    /// characters; the same visibility rule as `find-user-by-name` applies.
    ///
    /// Added by B179, after 0.104.0: a new function in an existing interface
    /// and no new manifest capability; no existing signature changed.
    find-users-by-name-prefix: func(prefix: string) -> result<string, string>;
}

/// Cache operations with tag-based invalidation.
interface cache-api {
    get: func(bin: string, key: string) -> option<string>;
    set: func(bin: string, key: string, value: string, tags-json: string);
    invalidate-tag: func(tag: string);
}

/// Inter-plugin communication.
interface plugin-api {
    invoke: func(plugin-name: string, function-name: string, payload: string)
        -> result<string, string>;
    plugin-exists: func(plugin-name: string) -> bool;
}

/// Structured logging.
interface logging {
    log: func(level: string, plugin: string, message: string);
}

/// AI API — access to AI providers via the kernel's secure provider registry.
/// Plugins submit requests as JSON; the kernel resolves the provider,
/// injects the API key, and returns a normalized response.
/// API keys never cross the WASM boundary.
interface ai-api {
    /// Make an AI request. Input is JSON-serialized `AiRequest`,
    /// output is JSON-serialized `AiResponse`.
    ai-request: func(request-json: string) -> result<string, string>;
}

/// Cryptographic primitives — SHA-256, HMAC-SHA256, secure random bytes,
/// constant-time comparison, and ES256 JWT signing with an operator-held
/// key. Plugins use these instead of bundling their own crypto into WASM
/// (large, slow, and risky). All byte outputs are hex-encoded strings.
///
/// ABI note (PF-3 / D-21): the registered host import field names now match
/// these kebab-case identifiers exactly (`sha256`, `hmac-sha256`,
/// `random-bytes`, `constant-time-eq`). The earlier snake_case host fields
/// (`hmac_sha256`, `random_bytes`, `constant_time_eq`) were normalized to
/// kebab-case so host imports and the WIT share one convention; the SDK
/// `#[link_name]` bindings link against these exact kebab-case names.
interface crypto-api {
    /// Hex-encoded SHA-256 of the input.
    sha256: func(data: string) -> result<string, string>;

    /// Hex-encoded HMAC-SHA256 of `message` keyed by `key`.
    hmac-sha256: func(key: string, message: string) -> result<string, string>;

    /// Hex-encoded cryptographically-secure random bytes (length 1..=256).
    random-bytes: func(len: u32) -> result<string, string>;

    /// Constant-time equality of two byte strings (timing-attack safe).
    constant-time-eq: func(a: string, b: string) -> bool;

    /// Sign a JWT with ES256, using a key the operator holds and mapped to
    /// this plugin. The key material never crosses into WASM memory: the
    /// plugin names it by `key-ref`, a short id the operator chose, never a
    /// raw environment variable or file path of the plugin's own choosing.
    ///
    /// The operator maps `(plugin name, key-ref)` to an environment variable
    /// or a file holding a PEM PKCS#8 P-256 private key (the `.p8` format
    /// Apple issues for APNs), in the `crypto_signing_keys` site config entry
    /// (see the plugin guide's "Signing a JWT" section). A plugin may use
    /// only the keys mapped for it; the host parses and caches the key and
    /// never returns it, logs it or puts it in an error.
    ///
    /// `header-json` is the JWS header the plugin wants, typically just
    /// `{"kid": "..."}`: the host sets `alg` to `ES256` and refuses a header
    /// that names a different one. `claims-json` is the JWT claim set,
    /// unexamined beyond being valid JSON. Returns the compact JWS
    /// (`header.claims.signature`, each part base64url-encoded).
    ///
    /// Refused, each with its own code: no key mapped for this plugin under
    /// `key-ref` (also the answer for a key mapped to a different plugin, so
    /// a refusal cannot be used to probe who owns a key-ref), the mapped key
    /// is not a usable P-256 key, `header-json` or `claims-json` is not valid
    /// JSON, and a header that names an `alg` other than `ES256`.
    ///
    /// Added by B273, after 0.105.0: a new function in an existing
    /// interface; no existing signature changed.
    sign-jwt-es256: func(key-ref: string, header-json: string, claims-json: string) -> result<string, s32>;
}

/// Outbound HTTP — the kernel performs the request on the plugin's behalf,
/// enforcing SSRF protection, scheme/host rules, a timeout, and a
/// response-size cap. Plugins cannot open sockets directly from WASM.
/// Input is JSON-serialized `HttpRequest`; output is JSON-serialized
/// `HttpResponse`.
interface http {
    request: func(request-json: string) -> result<string, string>;

    /// Open a streaming HTTP fetch (P11e / D-49; response metadata p11j /
    /// G-HTTP-META). Additive companion to `request` for response bodies too large
    /// to buffer whole in WASM memory (article HTML routinely exceeds 1 MB).
    /// Returns a JSON-serialized `HttpOpenResponse` `{handle, status, headers}`:
    /// the opaque streaming handle plus the response status and headers in the
    /// SAME representation as `request`'s `HttpResponse` (so conditional GET works
    /// on the streaming path — a `304` is distinguishable from an empty `200`, and
    /// a fresh `ETag`/`Last-Modified` is readable). The plugin then calls
    /// `http-read` on the handle repeatedly (each returning at most 64 KB, the tap
    /// I/O buffer) until it returns 0 (EOF), and must `http-close` the handle.
    /// `request`'s one-shot semantics and 1 MB cap are byte-identical and
    /// unaffected.
    ///
    /// A `304 Not Modified` response has no body, so the first `http-read` on its
    /// handle returns a clean EOF immediately (the status in the metadata is how a
    /// conditional GET is short-circuited).
    ///
    /// The metadata must fit the tap I/O buffer. A pathologically large header
    /// block that does not fit errors the open (parity with `request`'s
    /// response-too-large behavior) rather than silently truncating headers, so a
    /// dropped `ETag`/`Content-Type` can never go unnoticed.
    ///
    /// The handle is scoped to the current tap invocation's `Store`: it cannot be
    /// used from a later or concurrent tap call. The SAME SSRF fence as `request`
    /// (scheme allowlist; localhost/.local/.internal/.localhost + private,
    /// loopback, link-local and CGNAT IP-literal blocks, plus the rebinding-safe
    /// resolver and per-hop redirect revalidation — p11i) is applied on open.
    ///
    /// Total transferred bytes are bounded by the plugin's manifest-declared,
    /// kernel-capped total-transfer ceiling (`http_max_transfer`, default 1 MB,
    /// kernel max 16 MB — D-50). The old 60 s ceiling becomes a total-transfer
    /// wall-clock budget across all reads, plus a per-read timeout
    /// (`HttpRequest.timeout_ms`); a background tap is additionally bounded by the
    /// 150 s epoch (the epoch cuts CPU, the transfer budget cuts the wire).
    http-open: func(request-json: string) -> result<string, string>;

    /// Read up to 64 KB of the next body bytes from an open streaming handle
    /// (P11e / D-49). An empty result signals EOF. Fails if the handle is unknown,
    /// already closed, or from another tap call; if a read times out or the
    /// total-transfer wall-clock budget expires; on a network error; or if the
    /// total-transfer ceiling is exceeded mid-stream (which also catches a server
    /// that under-reports `Content-Length`).
    http-read: func(handle: u32) -> result<list<u8>, string>;

    /// Close a streaming handle and release its connection (P11e / D-49). Frees
    /// the slot so a subsequent read on the same handle fails cleanly. Closing an
    /// unknown or already-closed handle is an error.
    http-close: func(handle: u32) -> result<_, string>;
}

/// Plugin job queue — enqueue work (typically from `tap-cron`) for later
/// draining by the kernel, which invokes `tap-queue-worker` on the owning
/// plugin for each item. The calling plugin's name is injected by the
/// kernel so plugins cannot enqueue under another plugin's identity.
/// `payload-json` must be well-formed JSON.
interface queue {
    push: func(queue-name: string, payload-json: string) -> result<_, string>;

    /// Enqueue a job with options (P11d / D-48). Additive companion to `push`:
    /// `push` stays byte-identical for callers that need neither priority nor
    /// delay. `opts-json` is a JSON object with optional fields:
    ///   - `priority` (integer): higher values are drained first (default 0);
    ///   - `delay` (integer seconds): defer the first attempt by this many
    ///     seconds (default 0 = eligible immediately).
    /// The kernel injects the calling plugin's name (no impersonation) and
    /// applies v2 retry/backoff/dead-letter semantics regardless of entry point.
    /// `payload-json` must be well-formed JSON.
    enqueue: func(queue-name: string, payload-json: string, opts-json: string) -> result<_, string>;
}

/// Outgoing mail, narrow by construction (added at 0.101).
///
/// **The caller does not name the recipient.** A host function that sends to an
/// address the plugin supplies is a spam relay, and the blast radius is the
/// site's mail reputation and its SMTP credentials rather than the plugin's own
/// data. `send-to-site-contacts` sends to the address the site configured
/// (`site_mail`) and nowhere else: enough for a visitor to reach the site owner,
/// which is the case a CMS needs a plugin to cover, and useless for reaching
/// strangers.
///
/// Delivery goes through the site's own email service, so a plugin's mail shares
/// the kernel's SMTP transport, `from` address and circuit breaker. A plugin
/// cannot configure its own delivery, and cannot keep hammering a host the
/// kernel has already given up on.
///
/// Refused, each with its own error code: no SMTP host configured, no
/// `site_mail` configured, an empty subject or body, a subject or content type
/// carrying a control character (header injection), an unusable attachment
/// filename, more than 5 attachments, and more than 1 MB of attachment bytes in
/// total.
interface mail {
    /// A file attached to the message. `bytes` are the contents; the kernel
    /// applies the transfer encoding. Over the JSON boundary this record travels
    /// as `{filename, content_type, bytes_base64}`.
    record attachment {
        filename: string,
        content-type: string,
        bytes: list<u8>,
    }

    /// Send to the site's configured contact address only. No caller recipient.
    ///
    /// For both functions in this interface, success means the message was
    /// accepted for delivery: written to the kernel's durable outbox, which
    /// sends it with retries. It does not mean delivered, and a later bounce
    /// is not reported back. An error means it was not accepted. (BG18; the
    /// signatures and error codes are unchanged.)
    send-to-site-contacts: func(subject: string, body: string,
                                attachments: list<attachment>) -> result<_, string>;

    /// Send a plain text message to one of the site's own members, by user id,
    /// for a plugin that declares `mail_users = true` under `[capabilities]`.
    /// Declaring `mail` alone keeps meaning the site contact address only.
    ///
    /// The kernel resolves the address; the plugin never sees it, in a return
    /// value, an error or a log line. The message goes from the site's `from`
    /// address with a footer and `List-Unsubscribe` and
    /// `List-Unsubscribe-Post: List-Unsubscribe=One-Click` headers carrying a
    /// link that opts this user out of this plugin's mail. No attachments.
    ///
    /// Refused, each with its own code: without the capability; past the
    /// plugin's `mail_users` bucket or the per recipient `mail_recipient`
    /// bucket; a user who does not exist, is blocked or has no address (one
    /// code for all three); a user who opted out of this plugin's mail; and the
    /// subject and body rules `send-to-site-contacts` applies.
    ///
    /// Added by B73, after 0.104.0: a new function in an existing interface
    /// and a new manifest capability; no existing signature changed.
    send-to-user: func(user-id: string, subject: string, body: string) -> result<_, string>;
}

/// Text formats: filter text the way the kernel renders a field in a format.
///
/// A plugin that renders HTML a user wrote must pass it through `filter-text`
/// before returning it; the kernel does not filter a plugin's output for it.
/// The format is checked against the user the plugin acts for, by the rule the
/// item forms apply: `plain_text` always, `filtered_html` with
/// `use filtered_html`, `full_html` with `use full_html`.
///
/// Added by B71, after 0.104.0.
interface text-format {
    /// Filter `text` through the named format. Errors when the format is
    /// unknown or the acting user may not use it; never returns the text
    /// unfiltered in place of an error.
    filter-text: func(text: string, format: string) -> result<string, string>;
}

/// Query: run a Gather definition for the request's viewer, stages and language
/// (docs/design/plugin-query-surface.md, D-60).
///
/// `definition-json` is a Gather `QueryDefinition`, the JSON a site's gather is
/// stored as. `options-json` is {page, per_page, url_args}, every key optional;
/// `per_page` defaults to 20 and may be at most 100. The result is a
/// GatherResult: {items, total, page, per_page, total_pages, has_next,
/// has_prev, access_capped}.
///
/// A definition over `item` (or a record type) always reads for the user the
/// plugin is acting for, on the request's read stages (Live outside a plugin
/// route), in the request's language; the plugin sets none of the three and
/// `stage_aware = false` is refused (-80). Each item row carries `url`, its
/// alias or `/item/{id}`, and a filter on `url` (`equals` or `in`) finds items
/// by the address they are served at. From cron or the queue a content read
/// needs `item_background` (-61). It may join the kernel's join tables and the
/// plugin's own tables.
///
/// A definition over one of the plugin's own tables (migration-owned or in
/// `db_tables`) reads it as it is: no access predicate, no stage, no `url`. It
/// may join only the plugin's own tables, never content (-80).
///
/// Any table that is not content must be in the plugin's allowlist (-16).
/// Refused (-80): includes, `semantic_similarity`, a `url` filter other than
/// `equals` or `in`, and anything the gather validator rejects. Bounds (-81):
/// 100 rows, 32 filters, 8 sorts, 3 relationships. Statements run under a
/// 5 second timeout (-12 when it is hit).
///
/// Added by B80, after 0.105.0: a new interface; no existing signature changed.
interface query {
    run: func(definition-json: string, options-json: string) -> result<string, string>;
}

/// Owned vocabularies: vocabularies that belong to an owner the plugin
/// declares under `[[vocabulary_owners]]` in its manifest (a group, a club).
/// `create-owned` takes `{owner_type, owner_id, id, label, description?,
/// hierarchy?, weight?}` and returns the vocabulary; the owner type must be one
/// this plugin declared (-90), the id a new machine name (-91 invalid, -92
/// taken). `list-owned` returns the owner's vocabularies as a JSON array.
///
/// Added by B108, after 0.104.0: a new interface; no existing signature changed.
interface vocabulary {
    create-owned: func(request-json: string) -> result<string, string>;
    list-owned: func(owner-type: string, owner-id: string) -> result<string, string>;
}

/// The plugin world — all imports and exports for a Trovato plugin.
/// All tap functions use full-serialization (JSON in, JSON out).
///
/// Capability declaration (WASM-1 / WASM-2, contract shape — PF-2 / D-2 / D-19):
/// the `world` below lists the full superset of host interfaces. *Which* subset a
/// given plugin actually receives is declared per-plugin in the `[capabilities]`
/// table of its `{name}.info.toml` manifest (the real surface is the kernel's
/// `PluginInfo`/`PluginCapabilities` struct; this `.wit` is documentation):
///
///   [capabilities]
///   host_interfaces = ["db", "logging", "item-api"]  # WASM-1: imports this plugin may use
///   db_tables       = ["importer_jobs"]              # WASM-2: table allowlist (else derived
///                                                    #   from the plugin's migration-owned tables)
///   raw_sql         = false                          # D-19: gates `db.query-raw`/`db.execute-raw`
///
/// Semantics (frozen surface):
///   - `host_interfaces` is ENFORCED (WASM-1 / D-18): the per-plugin linker exposes
///     only the declared interfaces. Absent `[capabilities]` table (or empty
///     `host_interfaces`) → deny-all host imports (the WASM-1 flip; no longer
///     grant-all).
///   - `db_tables` is ENFORCED (WASM-2 / D-19): structured `db` calls are confined
///     to the effective allowlist = the plugin's migration-owned tables ∪ this list.
///     A structured call outside it is rejected before any query. The declaration
///     states table scope, not the enforcement mechanism — the same list can drive
///     the kernel-side allowlist (1.0) or per-plugin Postgres roles (post-1.0,
///     opt-in) with no contract change (the Option-B seam).
///   - `raw_sql = true` is ENFORCED (WASM-2 / D-19): required to call
///     `db.query-raw`/`db.execute-raw`; it WEAKENS the `db_tables` guarantee for that
///     plugin (the kernel does not parse raw SQL against the allowlist — the SQLI-1
///     surface) — a declared, auditable risk.
world plugin {
    import item-api;
    import db;
    import variables;
    import request-context;
    import user-api;
    import cache-api;
    import plugin-api;
    import logging;
    import ai-api;
    import crypto-api;
    import http;
    import queue;
    import mail;
    import text-format;
    import query;
    import vocabulary;

    // --- Tap export naming convention (PF-3 / D-1, sub-decision 1) ----------
    // Host *import* fields above are kebab-case and match these WIT identifiers
    // exactly. Tap *exports* below are documented in kebab-case here, but the
    // REAL exported WASM symbol the kernel dispatcher looks up is the snake_case
    // Rust function name the SDK `#[plugin_tap]` macro generates (e.g. this
    // `tap-item-view` is exported by the plugin as `tap_item_view`, looked up
    // verbatim at `tap/dispatcher.rs`). The kebab↔snake mapping is a pure
    // `-`↔`_` substitution; the D-20 consistency test (`plugin_test.rs`)
    // enforces that this documented export set equals the kernel's `KNOWN_TAPS`
    // under that mapping, so the two conventions cannot silently drift.
    //
    // Some taps below are DECLARED in the frozen contract but not yet dispatched
    // by the kernel (forward-declared in `KNOWN_TAPS`); these are marked
    // "(dispatch pending)". Their signatures document the intended payload shape.
    // ------------------------------------------------------------------------

    // Lifecycle — `tap-install` is dispatched (state.rs); `tap-enable`,
    // `tap-disable`, `tap-uninstall` are declared but not yet dispatched
    // (dispatch pending). Their `() -> result<_, string>` shape is the same
    // validated lifecycle signature `tap-install` uses, so nothing is guessed.
    export tap-install: func() -> result<_, string>;
    export tap-enable: func() -> result<_, string>;        // (dispatch pending)
    export tap-disable: func() -> result<_, string>;       // (dispatch pending)
    export tap-uninstall: func() -> result<_, string>;     // (dispatch pending)

    // Content type registration (returns JSON array of ContentTypeDefinition)
    export tap-item-info: func() -> string;

    // Item CRUD — full-serialization (item-json contains complete item)
    export tap-item-view: func(item-json: string) -> string;
    // (dispatch pending) — render+item payload grounded by the dispatched
    // `tap-item-view` and the render pipeline.
    export tap-item-view-alter: func(render-json: string, item-json: string) -> string;
    export tap-item-insert: func(item-json: string) -> result<_, string>;
    export tap-item-update: func(item-json: string) -> result<_, string>;
    export tap-item-delete: func(item-id: string) -> result<_, string>;
    export tap-item-access: func(item-json: string, op: string) -> string;

    // Pre-save mutation hook — fires before insert/update; plugins may return
    // a JSON object with a "fields" map to merge into the item (last wins).
    export tap-item-presave: func(item-json: string) -> string;

    // Field-level access control. The opaque `field-access-json` carries a
    // BATCH: a FieldAccessBatchInput { user{user_id,authenticated,permissions},
    // item_type, operation ("view"|"edit"), fields[] } — one dispatch decides a
    // whole field set for one type. The plugin returns a FieldAccessBatchResult
    // { decisions: map<field, "Allow"|"Deny"|"NoOpinion"> }; an absent field is
    // NoOpinion. The kernel aggregates deny-wins across plugins with a fail-open
    // default (NoOpinion / no implementer => visible). Granularity is type-level
    // (no per-item identity); per-item is a post-1.0 additive `item` block.
    export tap-field-access: func(field-access-json: string) -> string;

    // Categories (dispatch pending) — term-json/term-id payloads grounded by the
    // dispatched `tap-item-*` CRUD family.
    export tap-categories-term-insert: func(term-json: string) -> result<_, string>;
    export tap-categories-term-update: func(term-json: string) -> result<_, string>;
    export tap-categories-term-delete: func(term-id: string) -> result<_, string>;

    // Forms
    export tap-form-alter: func(form-id: string, form-json: string) -> string;
    export tap-form-validate: func(form-id: string, values-json: string) -> string;
    export tap-form-submit: func(form-id: string, values-json: string) -> result<_, string>;
    // AJAX form callback — fires for a custom trigger; receives a JSON object
    // {trigger, form_id, values} and returns an AjaxResponse (commands array).
    export tap-form-ajax: func(callback-json: string) -> string;

    // Routing & permissions (return JSON arrays). Both are dispatched at boot
    // from state.rs; a declaration is a constant, so it is collected once rather
    // than asked for per request. `tap-perm`'s result is also written to
    // `plugin_permission`, because `config import` validates a role file's
    // permission list from a separate process that has no AppState to read.
    export tap-menu: func() -> string;
    export tap-perm: func() -> string;

    // Admin navigation (returns a JSON array of AdminNavDefinition: section,
    // label, path, permission, optional card description). Dispatched once at
    // boot like tap-menu and tap-perm; the kernel merges the entries into the
    // admin sidebar and /admin dashboard under the same permission filter its
    // own links use. Display only: the route still checks its own access.
    export tap-admin-nav: func() -> string;

    // Serves one HTTP request for a `tap-menu` entry whose handler-type is
    // "api" and which names a callback (G-NO-PLUGIN-HTTP; added in the 0.99
    // series). Input is an ApiRequest JSON object
    // {callback, method, path, params, query, body, user_id, authenticated,
    // csrf_token}; output is an ApiResponse
    // {status, body, content_type, theme, title}. Dispatched by
    // routes/plugin_api.rs with services attached and the menu entry's
    // `permission` already checked, so the tap may write a plugin-owned table.
    //
    // `csrf_token` (added at 0.101) is a single-use token for this caller's
    // session, minted so a tap can serve a working `<form>`: write it into a
    // hidden `_token` input and the POST is accepted with no JavaScript, because
    // a state-changing plugin-served request takes its token from that field or
    // from an X-CSRF-Token header. Empty for a bearer-authenticated caller,
    // which is exempt from CSRF and is not being served a form.
    //
    // `theme` and `title` (added at 0.101) ask the kernel to treat the body as
    // page content and render it through the site's page template, with the site
    // header, navigation and tiles around it — the same path an item page takes,
    // template overrides included. Default false, so a response that does not ask
    // is served verbatim exactly as before: an admin screen or a JSON endpoint
    // does not want a theme. `content_type` is ignored when `theme` is true,
    // because a themed page is HTML. The body is still never sanitized by the
    // kernel; theming changes what surrounds a plugin's HTML, not what it is.
    export tap-api: func(request-json: string) -> string;

    // Theme (dispatch pending). Neither is dispatched, and neither is what a
    // plugin-served page uses to reach the theme — that is the `theme` field on
    // the `tap-api` response above, added at 0.101.
    //
    // `tap-theme`'s no-input `() -> string` shape has nothing to guess, and
    // nothing consumes what it would return: in Drupal the equivalent registers
    // templates, which needs template discovery and override resolution the
    // kernel does not have. `tap-preprocess-item`'s context+item payload is
    // grounded by `tap-item-view`, and dispatching it means first deciding which
    // render-context keys a plugin may overwrite (`csrf_token` and
    // `user_is_admin` are in there). Both are recorded in KNOWN-ISSUES.md rather
    // than dispatched with invented semantics.
    export tap-theme: func() -> string;
    export tap-preprocess-item: func(context-json: string, item-json: string) -> string;

    // Search
    export tap-item-update-index: func(item-json: string) -> string;

    // Cron & queues
    export tap-cron: func() -> result<_, string>;
    export tap-queue-info: func() -> string;
    export tap-queue-worker: func(item-json: string) -> result<_, string>;

    // User lifecycle — the login/logout/register/update/delete taps all receive
    // a JSON object carrying the affected user's id (`{"user_id": "..."}`).
    export tap-user-login: func(user-json: string) -> result<_, string>;
    export tap-user-logout: func(user-json: string) -> result<_, string>;
    export tap-user-register: func(user-json: string) -> result<_, string>;
    export tap-user-update: func(user-json: string) -> result<_, string>;
    export tap-user-delete: func(user-json: string) -> result<_, string>;

    // GDPR user-data export (dispatch pending) — plugins return their
    // per-user records as a JSON array of UserExportData.
    export tap-user-export: func(user-json: string) -> string;

    // Account-recovery extension point (FR-7c). A plugin provides one or more
    // recovery *methods*; the kernel owns the *flow* (account binding, the flow
    // nonce, expiry, single-use, rate limiting). The opaque `recovery-json` is
    // discriminated by `op` (describe | initiate | verify), exactly the
    // single-opaque-string convention `tap-field-access` uses:
    //   - describe  -> { "result":"methods", "methods":[ {method_id, display_name, available} ] }
    //   - initiate  -> { "result":"initiated", "status", "challenge_hint" (NO secrets), "expires_in_secs" }
    //   - verify    -> { "result":"verdict", "verdict":"Verified"|"Rejected"|"Pending"|"NoOpinion" }
    // The `verify` result carries a verdict and NOTHING else (no account id, no
    // session material): a plugin cannot name a different account to escalate
    // into. Method ids MUST be namespaced `<plugin_name>:<method>`. The kernel
    // fold is owner-scoped + fail-closed: a `Verified` counts ONLY from the
    // plugin owning the method_id namespace; any owner `Rejected` fails; no owner
    // `Verified` denies; a trapped handler casts no vote. The `-> string` is
    // transport-opaque only — the SDK binds a typed op-discriminated param
    // (RecoveryTapInput), never a literal `string` (which fails into a
    // silently-skipped error output). Frozen at PF-5; see `recovery.rs`.
    export tap-account-recovery: func(recovery-json: string) -> string;

    // Comments — full-serialization (comment-json contains the complete comment).
    export tap-comment-insert: func(comment-json: string) -> result<_, string>;
    export tap-comment-update: func(comment-json: string) -> result<_, string>;
    export tap-comment-delete: func(comment-json: string) -> result<_, string>;
    // Access check receives a single JSON object bundling the comment ids, the
    // operation, and the acting user id; returns an AccessResult (deny wins).
    export tap-comment-access: func(access-json: string) -> string;

    // Gather extensions — plugins declare extra filters/relationships/sorts
    // (returns a JSON GatherExtensionDeclaration; no input).
    export tap-gather-extend: func() -> string;

    // Owned vocabularies (B108): `{owner_type, owner_key, operation, user_id,
    // authenticated}` in, `{owner_id, access}` out, `access` one of grant,
    // deny, neutral. Dispatched only to the plugin that declared the owner type.
    export tap-vocabulary-owner-access: func(request-json: string) -> string;

    // AI governance (dispatch pending) — `tap-ai-request` decides allow/modify/
    // deny for an outbound AI request (AiRequestContext in, AiRequestDecision
    // out); `tap-chat-actions` returns the plugin's chat action definitions.
    //
    // `tap-chat-actions` is SUPERSEDED by the three assistant taps below and is
    // not going to be dispatched. It was the sketch of a plugin telling the
    // visitor chatbot what it could do; what a plugin actually needed was a
    // conversation of its own, scoped to one thing being configured, with the
    // person applying every write. That is `tap-assistant-*`. The declaration
    // stays so no manifest naming it stops loading.
    export tap-ai-request: func(context-json: string) -> string;
    export tap-chat-actions: func() -> string;

    // AI Assistant (added at 0.102) — configure one thing by conversation.
    //
    // `tap-assistant-scopes` is dispatched once at boot, without services, into
    // the kernel's assistant registry: it returns a JSON array of AssistantScope
    // {name, label, description, permission, id_kind, item_types, prompt,
    // suggestions, tools[]}, where each tool is {name, description, parameters
    // (a JSON Schema object), kind ("read"|"write"), risk}. The registry
    // validates names against [a-z0-9_]+, rejects a scope name a another plugin
    // already claimed, and caps tools at 32, suggestions at 6 and the prompt at
    // 8 KiB. An invalid scope is dropped with a warning; boot is never failed.
    //
    // `tap-assistant-context` is dispatched with services and the caller's real
    // user when a conversation opens or is reset. Input is an
    // AssistantContextRequest {scope, scope_id, user_id}; output is an
    // AssistantContext {title, snapshot, links[]}. The snapshot is the model's
    // whole view of the domain, in plain text; the kernel truncates it at a line
    // boundary to the site's cap and appends "[snapshot truncated]".
    //
    // `tap-assistant-tool` is dispatched with services and the caller's real
    // user. Input is an AssistantToolCall {scope, scope_id, tool, arguments,
    // mode ("describe"|"execute"), user_id, proposal_id}; output is an
    // AssistantToolResult {ok, content, summary}. A read tool is dispatched with
    // mode "execute" as soon as the model calls it. A write tool is dispatched
    // with "describe" first, changes nothing, and must set `summary`: that
    // becomes the proposal the person reads and applies. Only an applied
    // proposal is dispatched with "execute". A tool the scope did not declare is
    // never dispatched.
    export tap-assistant-scopes: func() -> string;
    export tap-assistant-context: func(request-json: string) -> string;
    export tap-assistant-tool: func(call-json: string) -> string;

    // NOTE: a CSP-alteration tap was removed pre-1.0 (PF-4.1). It had zero
    // implementation and zero dispatch, and its `(csp-json) -> string`
    // signature was inferred rather than derived from a real call site —
    // freezing it would have locked an unvalidated guess into the contract.
    // Re-add post-1.0 with a signature grounded in an actual CSP dispatch site.
}
