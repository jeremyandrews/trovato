# Trovato CMS Configuration
# Copy this to .env and adjust as needed.
#
# Everything below is read either by the server process (PORT, DATABASE_URL, …)
# or by docker-compose (POSTGRES_*). Plugin tuning is NOT here: it lives in site
# variables, because it is changed at runtime by an operator rather than at
# deploy time.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HTTP server port (inside the container; compose maps it out).
PORT=3000

# The site's public base URL. Every absolute address the kernel emits is built
# from it: sitemap.xml, the Sitemap: line in robots.txt, the RSS feeds, the
# canonical link, the Open Graph tags and the links in outgoing mail. Defaults
# to http://localhost:$PORT, which is wrong for anything a crawler can reach.
SITE_URL=http://localhost:3000

# PostgreSQL connection URL.
DATABASE_URL=postgres://trovato:trovato@localhost:5432/trovato

# Redis connection URL.
REDIS_URL=redis://127.0.0.1:6379

# Maximum database connections in pool.
DATABASE_MAX_CONNECTIONS=10

# Reverse proxies whose X-Forwarded-For and X-Forwarded-Proto headers are
# believed: comma-separated addresses and CIDR ranges, every hop in front of
# Trovato. Empty (the default) trusts none: the client address is the socket
# peer, and no response carries Strict-Transport-Security, because HTTPS is
# known only from a trusted proxy's X-Forwarded-Proto. A TLS-terminating proxy
# must be listed here for HSTS. A bad entry refuses
# to start. Behind nginx on the same host: TRUSTED_PROXIES=127.0.0.1,::1
# TRUSTED_PROXIES=

# What of a client address is stored (audit log, site log, session list):
# full (default), truncated (IPv4 /24, IPv6 /48) or none. Rate limiting always
# uses the whole address, in Redis only, under keys that expire within the hour.
# CLIENT_IP_STORAGE=full

# Whether the session cookie is Secure: always (default) or never. never is for
# a plain HTTP LAN or development site only, where a browser would otherwise
# drop the cookie and nobody could log in; it lets the session cookie travel
# over plain HTTP, so never use it on the internet. Refused with an https://
# SITE_URL or with COOKIE_SAME_SITE=none.
# COOKIE_SECURE=always

# Edge caching behind a CDN (B303). An anonymous, cookie-free GET/HEAD that
# answers 200 with text/html, in a language the URL alone decides, may be
# marked shareable: Cache-Control: public, max-age=<EDGE_CACHE_MAX_AGE>,
# s-maxage=<EDGE_CACHE_S_MAXAGE>, plus a tag header listing what it was built
# from. The public half stays off (and no existing site starts being cached by
# a CDN on upgrade) until EDGE_CACHE_S_MAXAGE is set above 0; a signed-in, a
# token-bearing, a non-GET/HEAD or a cookie-setting response always gets
# Cache-Control: private, no-store instead. See docs/deployment/cdn.md.
# EDGE_CACHE_MAX_AGE=0
# EDGE_CACHE_S_MAXAGE=0
# Header carrying the cache tags a CDN purges by: Surrogate-Key (default,
# Fastly/Varnish), Cache-Tag (Cloudflare) or Edge-Cache-Tag (Akamai).
# EDGE_CACHE_TAG_HEADER=Surrogate-Key

# Rust logging level (RUST_LOG format).
# Examples: debug, info, trovato=debug,sqlx=warn
RUST_LOG=info,tower_http=debug,sqlx=warn

# Shared secret in the cron URL: POST /cron/<CRON_KEY>.
# CHANGE THIS before exposing the server. Anyone who can reach the route with
# the right key can drive every plugin's scheduled work.
CRON_KEY=default-cron-key

# Seconds between the built-in cron scheduler's runs. Unset, the cron_interval_secs
# site setting (edited on /admin/reports/cron, default 300) decides; set, this
# overrides it. 0 turns the scheduler off, leaving cron to POST /cron/<CRON_KEY>.
# CRON_INTERVAL_SECS=300

# Timer throttles (/admin/reports/timers/settings). Unset, the site setting
# decides; set, the variable overrides it and the form shows it read only.
# TIMER_MAX_CONCURRENT=4
# TIMER_MAX_PER_PLUGIN=10000
# TIMER_MIN_REPEAT_SECS=60
# TIMER_MAX_PAYLOAD_BYTES=4096   (at most 65536)

# The site log (/admin/reports/log) keeps warnings, errors, sign-ins, plugin
# changes and config imports. Cron prunes it to whichever is smaller: this many
# days, or this many rows.
# SYSTEM_LOG_RETENTION_DAYS=30
# SYSTEM_LOG_MAX_ROWS=100000

# ---------------------------------------------------------------------------
# docker-compose: Postgres and Redis
# ---------------------------------------------------------------------------
# The compose Postgres image defaults to pgvector/pgvector:pg17 — Postgres 17
# with the `vector` extension available, which is what enables the kernel's
# semantic search on a fresh database.
#
# UPGRADING AN EXISTING VOLUME: the pgvector image is built on a different base
# than the plain postgres:17 image, so Postgres will report a collation version
# mismatch and text index ordering could differ from what those indexes were
# built with. Either repair it once —
#   docker compose exec postgres psql -U trovato -d trovato \
#     -c 'REINDEX DATABASE trovato' -c 'ALTER DATABASE trovato REFRESH COLLATION VERSION'
# — or pin the old image here and forgo pgvector on that volume.
POSTGRES_IMAGE=pgvector/pgvector:pg17

POSTGRES_USER=trovato
POSTGRES_PASSWORD=trovato
POSTGRES_DB=trovato

# Host ports. Change these if something else already owns 5432/6379.
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# What is deliberately NOT here
# ---------------------------------------------------------------------------
# AI provider credentials are site configuration, not environment: they are
# entered in the admin UI (or `trovato config`), stored in `site_config`, and
# referenced by name. A plugin asks the kernel for a model and the kernel
# decides which provider serves it, so no plugin carries an API key of its own.
#
# Argus, the news-intelligence plugin that used to ship an `argus` compose
# profile here, lives in its own repository (jeremyandrews/argus) with its own
# compose file and .env.example.
