# Trovato CMS Configuration
# Copy this to .env and adjust as needed.
#
# Everything below is read either by the server process (PORT, DATABASE_URL, …)
# or by docker-compose (POSTGRES_*, ARGUS_*). Argus's own tuning is NOT here:
# it lives in site variables, because it is changed at runtime by an operator
# rather than at deploy time. The full list is in plugins/argus/README.md.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HTTP server port (inside the container; compose maps it out).
PORT=3000

# PostgreSQL connection URL.
DATABASE_URL=postgres://trovato:trovato@localhost:5432/trovato

# Redis connection URL.
REDIS_URL=redis://127.0.0.1:6379

# Maximum database connections in pool.
DATABASE_MAX_CONNECTIONS=10

# Rust logging level (RUST_LOG format).
# Examples: debug, info, trovato=debug,sqlx=warn
RUST_LOG=info,tower_http=debug,sqlx=warn

# Shared secret in the cron URL: POST /cron/<CRON_KEY>.
# CHANGE THIS before exposing the server. Anyone who can reach the route with
# the right key can drive every plugin's scheduled work.
CRON_KEY=default-cron-key

# ---------------------------------------------------------------------------
# docker-compose: Postgres and Redis
# ---------------------------------------------------------------------------
# The compose Postgres image defaults to pgvector/pgvector:pg17 — Postgres 17
# with the `vector` extension available, which is what enables the kernel's
# semantic search on a fresh database.
#
# UPGRADING AN EXISTING VOLUME: the pgvector image is built on a different base
# than the plain postgres:17 image, so Postgres will report a collation version
# mismatch and text index ordering could differ from what those indexes were
# built with. Either repair it once —
#   docker compose exec postgres psql -U trovato -d trovato \
#     -c 'REINDEX DATABASE trovato' -c 'ALTER DATABASE trovato REFRESH COLLATION VERSION'
# — or pin the old image here and forgo pgvector on that volume.
POSTGRES_IMAGE=pgvector/pgvector:pg17

POSTGRES_USER=trovato
POSTGRES_PASSWORD=trovato
POSTGRES_DB=trovato

# Host ports. Change these if something else already owns 5432/6379.
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# docker-compose: the Argus profile
# ---------------------------------------------------------------------------
#   docker compose --profile argus up -d
#
# Brings up Postgres, Redis, Trovato with the argus plugin installed and
# enabled, and the cron poker that drives it.

# Host port the Argus site is served on.
ARGUS_PORT=3002

# Seconds between cron pokes. Argus does nothing at all without them: the
# kernel runs no internal scheduler, so this loop is the pipeline's clock.
# 60 is a sensible default — a feed's own fetch interval (300s minimum) is what
# actually decides how often it is polled.
ARGUS_CRON_INTERVAL=60

# ---------------------------------------------------------------------------
# What is deliberately NOT here
# ---------------------------------------------------------------------------
# AI provider credentials are site configuration, not environment: they are
# entered in the admin UI (or `trovato config`), stored in `site_config`, and
# referenced by name. Argus asks the kernel for a model and the kernel decides
# which provider serves it, so there is no Argus-specific API key.
#
# Notification channels are content: an administrator creates an
# "Argus Notification Channel" item at /admin/content/add/argus_notify_channel.
# A site with no channels notifies nobody, which is the only safe default for
# something that sends messages.
