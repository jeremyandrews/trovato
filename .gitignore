# Database backups
/backups/

# Build artifacts
/target
**/*.rs.bk

# WASM binaries (generated, not source)
*.wasm

# Editor files
*.swp
*.swo
*~
.DS_Store

# Local coding-agent configuration and worktrees (per developer, never shared)
.claude/
.agents/
.codex/
.cursor/
AGENTS.md
CLAUDE.md

# SQLx offline cache (regenerated with cargo sqlx prepare)
# Uncomment if not using offline mode in CI
# .sqlx/

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# Docker compose override (may contain API keys or local config)
docker-compose.override.yml

# Docker volumes (local dev data)
docker-data/

# File uploads (runtime data)
uploads/
**/uploads/

# Python virtual environments
.venv/
**/.venv/

# Local environment-discovery notes (per developer machine)
TOOLS.md
target/
**/target/

# Advisory database checkout (scripts/security-audit.sh; CI checks it out here)
/advisory-db/

# Node dependencies of the page builder editor (the built bundle is committed under static/)
node_modules/

# The admin accessibility harness (tests/admin-a11y): its dependencies, the
# signed-in session it saves, and its run output.
tests/admin-a11y/node_modules/
tests/admin-a11y/.auth/
tests/admin-a11y/test-results/
tests/admin-a11y/playwright-report/

# The search index the kernel builds by default (PAGEFIND_OUTPUT_DIR is
# ./static/pagefind): generated, never source.
/static/pagefind/
/static/.pagefind_build_*/
